# Copy to .env and adjust. Docker Compose reads .env automatically.
# When running the app with Maven, export these in your shell instead.

POSTGRES_DB=helpdesk
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=helpdesk

JWT_SECRET=change-me-this-is-a-dev-only-secret-key-123456

# SLA: time to resolve by priority (ISO-8601). Shorten to test breaches, e.g. SLA_URGENT=PT1M
# SLA_URGENT=PT4H
# SLA_HIGH=PT8H
# SLA_MEDIUM=PT24H
# SLA_LOW=PT72H
# SLA_CHECK_INTERVAL=PT1M
